[Unit]
Description=Satmi dashboard background scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=satmi
WorkingDirectory=/opt/satmi
ExecStart=/usr/bin/node --env-file=/etc/satmi/scheduler.env /opt/satmi/scripts/scheduler.mjs
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
