{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test": "npm run build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "sync:full": "tsx scripts/full-sync.ts",
    "db:generate": "drizzle-kit generate",
    "test:regression": "node --test tests/rendered-html.test.mjs",
    "test:operations": "node --import tsx --test tests/operations.test.ts",
    "check:operations": "node --env-file=.env.local --import tsx scripts/check-operations-config.ts",
    "scheduler": "node --env-file=.env.local scripts/scheduler.mjs",
    "catalog:fetch": "node --env-file=.env.local scripts/fetch-shopify-products.mjs",
    "vercel-build": "npm run build && node --import tsx scripts/bootstrap-production.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "next": "^16.3.4",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
